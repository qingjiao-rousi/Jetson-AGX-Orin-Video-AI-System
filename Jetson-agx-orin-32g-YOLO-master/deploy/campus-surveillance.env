# Campus surveillance deployment configuration.
# This file is safe to copy to /etc/campus-surveillance/campus-surveillance.env.

PROJECT_ROOT_OVERRIDE=@PROJECT_ROOT@
VIDEO_DIR=@PROJECT_PARENT@/video
OUTPUT_ROOT=@OUTPUT_ROOT@
RUNTIME_ROOT=@RUNTIME_ROOT@
LOG_ROOT=@LOG_ROOT@

DEEPSTREAM_DIR=/opt/nvidia/deepstream/deepstream-7.1

SOURCE_COUNT=8
RTSP_HOST=127.0.0.1
RTSP_PORT=8555
MOUNT_PREFIX=stream
RTSP_BASE=rtsp://127.0.0.1:8555/stream

START_SIMULATOR=1
START_UI=1
UI_HOST=0.0.0.0
UI_PORT=8090

SERVICE_OUTPUT_DIR=@OUTPUT_ROOT@/campus_surveillance
OUTPUT_SINK=fake
RUN_SECONDS=0

ENABLE_DROP_OLD_FRAMES=1
ENABLE_HARDWARE_FALLBACK=1
ENABLE_LAST_FRAME_KEEPALIVE=1
LAST_FRAME_KEEPALIVE_TIMEOUT_MS=1000
STALE_AFTER_SECONDS=5
ENABLE_TEGRASTATS=1
TEGRASTATS_INTERVAL_MS=1000

RETENTION_DAYS=7
MAX_OUTPUT_GB=20
